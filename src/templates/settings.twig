{% import '_includes/forms' as forms %}

<h2>{{ 'Integrations'|t('enquiries-by-roogul') }}</h2>
<p class="light">{{ 'Credentials are shared by every form. Use environment variables (e.g. `$BREVO_API_KEY`) so keys stay out of project config.'|t('enquiries-by-roogul')|md(inlineOnly=true) }}</p>

{% for integration in integrations %}
    {% set html = integration.getSettingsHtml() %}
    {% if html %}
        <fieldset class="enq-settings-group">
            <legend class="h3">{{ integration.displayName() }}</legend>
            {{ html|raw }}
        </fieldset>
    {% endif %}
{% endfor %}

<hr>

<h2>{{ 'Spam protection'|t('enquiries-by-roogul') }}</h2>

{{ forms.textField({
    label: 'Honeypot field name'|t('enquiries-by-roogul'),
    instructions: 'Name of the hidden input bots tend to fill in. Change it if you see spam getting through.'|t('enquiries-by-roogul'),
    name: 'honeypotName',
    value: settings.honeypotName,
    errors: settings.getErrors('honeypotName'),
    code: true,
}) }}

{{ forms.textField({
    label: 'Minimum time to submit'|t('enquiries-by-roogul'),
    instructions: 'Submissions sent faster than this many seconds after the page loaded are treated as spam. 0 turns it off.'|t('enquiries-by-roogul'),
    name: 'minSubmitSeconds',
    value: settings.minSubmitSeconds,
    type: 'number',
    min: 0,
    size: 5,
    errors: settings.getErrors('minSubmitSeconds'),
}) }}

{{ forms.lightswitchField({
    label: 'Keep spam'|t('enquiries-by-roogul'),
    instructions: 'Store spam (never sent anywhere) so you can check for false positives.'|t('enquiries-by-roogul'),
    name: 'storeSpam',
    on: settings.storeSpam,
}) }}

{{ forms.autosuggestField({
    label: 'Cloudflare Turnstile site key'|t('enquiries-by-roogul'),
    instructions: 'Optional. Turn Turnstile on per form once both keys are set.'|t('enquiries-by-roogul'),
    name: 'turnstileSiteKey',
    value: settings.turnstileSiteKey,
    suggestEnvVars: true,
}) }}

{{ forms.autosuggestField({
    label: 'Cloudflare Turnstile secret key'|t('enquiries-by-roogul'),
    name: 'turnstileSecretKey',
    value: settings.turnstileSecretKey,
    suggestEnvVars: true,
}) }}

<hr>

<h2>{{ 'Data'|t('enquiries-by-roogul') }}</h2>

{{ forms.textField({
    label: 'Delete submissions after (days)'|t('enquiries-by-roogul'),
    instructions: 'Old submissions are deleted during garbage collection. 0 keeps them forever.'|t('enquiries-by-roogul'),
    name: 'retentionDays',
    value: settings.retentionDays,
    type: 'number',
    min: 0,
    size: 5,
    errors: settings.getErrors('retentionDays'),
}) }}

{{ forms.textField({
    label: 'Delete spam after (days)'|t('enquiries-by-roogul'),
    name: 'spamRetentionDays',
    value: settings.spamRetentionDays,
    type: 'number',
    min: 0,
    size: 5,
    errors: settings.getErrors('spamRetentionDays'),
}) }}

{{ forms.lightswitchField({
    label: 'Store IP address and browser'|t('enquiries-by-roogul'),
    name: 'storeIpAddress',
    on: settings.storeIpAddress,
}) }}

<hr>

<h2>{{ 'Delivery'|t('enquiries-by-roogul') }}</h2>

{{ forms.lightswitchField({
    label: 'Send straight after each submission'|t('enquiries-by-roogul'),
    instructions: 'Runs the queue once the visitor’s response has been sent, so emails and CRM syncs go out without waiting for a Control Panel visit. Turn off if you run a queue worker.'|t('enquiries-by-roogul'),
    name: 'runQueueAfterSubmit',
    on: settings.runQueueAfterSubmit,
}) }}

{{ forms.textField({
    label: 'Attempts before giving up'|t('enquiries-by-roogul'),
    instructions: 'Timeouts, rate limits and server errors are retried after 1, 5, 15 and 60 minutes. Bad credentials or rejected data fail straight away.'|t('enquiries-by-roogul'),
    name: 'maxAttempts',
    value: settings.maxAttempts,
    type: 'number',
    min: 1,
    max: 10,
    size: 5,
    errors: settings.getErrors('maxAttempts'),
}) }}

{{ forms.textField({
    label: 'Navigation label'|t('enquiries-by-roogul'),
    name: 'cpNavLabel',
    value: settings.cpNavLabel,
    errors: settings.getErrors('cpNavLabel'),
}) }}

{% css %}
.enq-settings-group { margin: 0 0 24px; padding: 0; border: 0; }
.enq-settings-group legend { margin-bottom: 12px; }
{% endcss %}
