<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ form.name }}</title>
</head>
<body style="margin:0;padding:24px;background:#f4f5f7;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f2933;">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:640px;margin:0 auto;background:#ffffff;border-radius:6px;">
        <tr>
            <td style="padding:24px 28px 8px;">
                <h1 style="margin:0;font-size:18px;font-weight:600;">{{ 'New {form} submission'|t('enquiries-by-roogul', { form: form.name }) }}</h1>
                <p style="margin:6px 0 0;font-size:13px;color:#606d7b;">{{ submission.dateCreated|datetime('medium') }}</p>
            </td>
        </tr>
        <tr>
            <td style="padding:12px 28px 20px;">
                <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
                    {% for row in values %}
                        <tr>
                            <td style="padding:10px 12px 10px 0;border-top:1px solid #e3e5e8;font-size:13px;font-weight:600;color:#606d7b;vertical-align:top;width:32%;">{{ row.label }}</td>
                            <td style="padding:10px 0;border-top:1px solid #e3e5e8;font-size:15px;vertical-align:top;word-break:break-word;">{{ row.value ? row.value|nl2br : '—' }}</td>
                        </tr>
                    {% endfor %}
                </table>
            </td>
        </tr>
        {% if submission.referrer or cpUrl %}
            <tr>
                <td style="padding:0 28px 24px;font-size:12px;color:#606d7b;">
                    {% if submission.referrer %}{{ 'Sent from {url}'|t('enquiries-by-roogul', { url: submission.referrer }) }}<br>{% endif %}
                    {% if cpUrl %}<a href="{{ cpUrl }}" style="color:#0b69a3;">{{ 'View in Craft'|t('enquiries-by-roogul') }}</a>{% endif %}
                </td>
            </tr>
        {% endif %}
    </table>
</body>
</html>
